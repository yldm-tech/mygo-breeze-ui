{
  "name": "mygo-breeze-ui",
  "private": true,
  "description": "MyGo native UI widgets that look like macOS, Windows 11 and GNOME controls, with a CLI and MCP tools",
  "keywords": [
    "adwaita",
    "breeze-ui",
    "fluent",
    "golang",
    "macos",
    "mcp",
    "mygo",
    "native-ui"
  ],
  "homepage": "https://github.com/yldm-tech/mygo-breeze-ui#readme",
  "bugs": {
    "url": "https://github.com/yldm-tech/mygo-breeze-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yldm-tech/mygo-breeze-ui.git"
  },
  "workspaces": [
    "packages/breeze-cli",
    "packages/breeze-mcp",
    "website"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/breeze-mcp build",
    "test": "bun test packages/breeze-mcp",
    "typecheck": "bun run --cwd packages/breeze-mcp typecheck",
    "site:build": "bun run --cwd website build",
    "site:typecheck": "bun run --cwd website typecheck",
    "site:test": "bun run --cwd website test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  }
}
