{
  "name": "mygo-breeze-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/breeze-cli",
    "packages/breeze-mcp"
  ],
  "scripts": {
    "build": "bun run --cwd packages/breeze-mcp build",
    "test": "bun test packages/breeze-mcp",
    "typecheck": "bun run --cwd packages/breeze-mcp typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "description": "Tailwind-inspired typed native UI components, utilities, CLI, and MCP tools for MyGo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yldm-tech/mygo-breeze-ui.git"
  },
  "homepage": "https://github.com/yldm-tech/mygo-breeze-ui#readme",
  "bugs": {
    "url": "https://github.com/yldm-tech/mygo-breeze-ui/issues"
  },
  "keywords": [
    "mygo",
    "breeze-ui",
    "native-ui",
    "tailwind",
    "golang",
    "mcp"
  ]
}
